# Diese Werte NICHT in GitHub hochladen (steht schon in .gitignore) —
# sondern in Netlify unter "Site configuration → Environment variables" eintragen.
# Diese Datei ist nur eine Vorlage/Gedächtnisstütze für dich.

# Supabase (Project Settings → API)
SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=DEIN-SERVICE-ROLE-KEY

# Geheimer Schlüssel zum Signieren der Login-Sitzungen — schon zufällig generiert,
# kannst du so verwenden oder durch einen eigenen ersetzen:
JWT_SECRET=JorwaDuc8jutftlwAZMGyDWFU-mQpScK

# Öffentliche Adresse deiner Netlify-Seite (für Logo in E-Mails + Live-Chat-Links)
SITE_URL=https://DEIN-PROJEKT-NAME.netlify.app

# web.de Postfach (App-Passwort, nicht das normale Login-Passwort!)
WEBDE_EMAIL=deine-adresse@web.de
WEBDE_APP_PASSWORD=dein-app-passwort
